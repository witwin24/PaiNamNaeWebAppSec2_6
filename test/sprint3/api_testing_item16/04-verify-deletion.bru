meta {
  name: Verify Deletion
  type: http
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("Login should fail", () => {
    expect([401, 404]).to.include(res.status)
  })
  test("Response has success false ",()=>{
    const body = res.getBody();
    expect(body).to.have.property("success", false);
  })
  test("",()=>{
    const body = res.getBody();
    expect(body).to.have.property("data", null);
  })
}
